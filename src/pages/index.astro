---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container">
			<h1 class="page-title"><span class="terminal-symbol">&gt;</span> ARCHIVED LOGS</h1>
			<p class="subtitle">记录所有的技术沉淀与系统实践工程日志。</p>

			<section class="post-grid">
				{
					posts.map((post) => (
						<article class="post-card">
							<a href={`/blog/${post.slug}/`}>
								{post.data.heroImage && (
									<img width={720} height={360} src={post.data.heroImage} alt="" class="hero-img" />
								)}
								<div class="card-body">
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h2 class="title">{post.data.title}</h2>
									{post.data.description && <p class="description">{post.data.description}</p>}
								</div>
							</a>
						</article>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.container {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	.page-title {
		font-size: 1.8rem;
		margin-bottom: 0.2rem;
	}
	.terminal-symbol {
		color: #58a6ff;
	}
	.subtitle {
		color: #8b949e;
		margin-bottom: 2rem;
		border-bottom: 1px solid #30363d;
		padding-bottom: 1rem;
	}
	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
	}
	.post-card {
		background: #161b22;
		border: 1px solid #30363d;
		border-radius: 8px;
		overflow: hidden;
		transition: transform 0.2s, border-color 0.2s;
	}
	.post-card:hover {
		transform: translateY(-3px);
		border-color: #58a6ff;
	}
	.post-card a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.hero-img {
		width: 100%;
		height: 160px;
		object-fit: cover;
		border-bottom: 1px solid #30363d;
	}
	.card-body {
		padding: 1.2rem;
	}
	.date {
		color: #3fb950;
		font-size: 0.8rem;
		margin: 0 0 0.5rem 0;
	}
	.title {
		color: #f0f6fc;
		font-size: 1.15rem;
		margin: 0 0 0.5rem 0;
		line-height: 1.4;
	}
	.description {
		color: #8b949e;
		font-size: 0.85rem;
		margin: 0;
		line-height: 1.5;
	}
</style>