---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🚀 欢迎来到 Cyril 的技术空间</h1>
			<p>
				这里记录关于 <strong>Linux 系统运维</strong>、<strong>后端开发</strong>、<strong>网络架构</strong> 以及各种极客折腾实践。
			</p>

			<h2>技术栈与环境</h2>
			<ul>
				<li><strong>操作系统</strong>: Ubuntu Server 24.04 LTS / Windows 11</li>
				<li><strong>核心框架</strong>: Astro, Node.js, Flutter</li>
				<li><strong>部署架构</strong>: Docker, PM2, Cloudflare Pages, Nginx</li>
			</ul>

			<h2>最新动态</h2>
			<p>
				查阅 <a href="/blog">博客文章</a> 获取最新的技术笔记与教程。
			</p>
		</main>
		<Footer />
	</body>
</html>