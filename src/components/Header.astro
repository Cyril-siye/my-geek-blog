---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="nav-inner">
		<a href="/" class="logo">
			<span class="logo-prompt">cyril@log</span><span class="logo-sep">:</span><span class="logo-path">~</span><span class="logo-sep">$</span>
		</a>

		<div class="internal-links">
			<HeaderLink href="/">~/home</HeaderLink>
			<HeaderLink href="/blog">~/blog</HeaderLink>
			<HeaderLink href="/tags">~/tags</HeaderLink>
			<HeaderLink href="/about">~/about</HeaderLink>
		</div>

		<div class="status-area">
			<span class="status"><span class="status-dot"></span> ONLINE</span>
			<a href="/rss.xml" class="icon-link" title="RSS 订阅" target="_blank">
				<span class="sr-only">RSS</span>
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9zM6.18 15.64a2.18 2.18 0 1 0 0 4.36 2.18 2.18 0 0 0 0-4.36z"/>
				</svg>
			</a>
			<a href="https://github.com/Cyril-siye" class="icon-link" title="GitHub" target="_blank">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</nav>
	<div class="scanline"></div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(8, 9, 12, 0.82);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.nav-inner {
		max-width: var(--max-width);
		height: var(--header-height);
		margin: 0 auto;
		padding: 0 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.logo {
		font-size: 0.95rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.logo:hover {
		text-shadow: none;
	}

	.logo-prompt { color: var(--green); }
	.logo-sep { color: var(--text-faint); }
	.logo-path { color: var(--blue); }

	.internal-links {
		display: flex;
		gap: 0.25rem;
	}

	.internal-links :global(a) {
		padding: 0.35rem 0.8rem;
		font-size: 0.82rem;
		color: var(--text-dim);
		border: 1px solid transparent;
		border-radius: var(--radius);
		transition: all 0.15s ease;
	}

	.internal-links :global(a:hover) {
		color: var(--green);
		text-shadow: none;
		background: rgba(63, 217, 127, 0.06);
	}

	.internal-links :global(a.active) {
		color: var(--green);
		border-color: var(--green-dim);
		background: rgba(63, 217, 127, 0.1);
		box-shadow: inset 0 0 12px rgba(63, 217, 127, 0.08);
		font-weight: 400;
		text-decoration: none;
	}

	.status-area {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.status {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: var(--green);
	}

	.icon-link {
		color: var(--text-dim);
		display: inline-flex;
		transition: color 0.15s ease, transform 0.15s ease;
	}

	.icon-link:hover {
		color: var(--green);
		transform: translateY(-1px);
		text-shadow: none;
	}

	.scanline {
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--green-dim), transparent);
		opacity: 0.5;
	}

	@media (max-width: 720px) {
		.status { display: none; }
		.nav-inner { padding: 0 0.9rem; }
		.internal-links :global(a) { padding: 0.3rem 0.5rem; }
	}
</style>
