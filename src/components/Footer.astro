---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-line">
			<span class="prompt">cyril@log:~$</span>
			<span class="cmd">exit</span>
			<span class="result">— session closed, connection to blog terminated.</span>
		</div>

		<div class="footer-meta">
			<span>&copy; {today.getFullYear()} Cyril · Powered by <a href="https://astro.build" target="_blank">Astro</a> · 部署于 Cloudflare Pages</span>
			<span class="uptime">uptime: 99.99% · build: stable</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 5rem;
		border-top: 1px solid var(--border);
		background: var(--bg-inset);
	}

	.footer-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1.8rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.footer-line {
		font-size: 0.82rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: baseline;
	}

	.prompt { color: var(--green); }
	.cmd { color: var(--text-bright); font-weight: 700; }
	.result { color: var(--text-faint); }

	.footer-meta {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.75rem;
		color: var(--text-dim);
	}

	.uptime {
		color: var(--text-faint);
	}
</style>
