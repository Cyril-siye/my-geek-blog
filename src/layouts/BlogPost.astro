---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Comments from '../components/Comments.astro';

type Props = CollectionEntry<'blog'>['data'] & { showComments?: boolean };

const { title, description, pubDate, updatedDate, heroImage, showComments = true } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class="article-container fade-up">
			<article class="term-window">
				<div class="term-bar">
					<span class="term-dots"><i></i><i></i><i></i></span>
					<span class="term-path">cyril@log:~/posts — vim post.md</span>
				</div>

				<div class="term-body article-body">
					<header class="article-header">
						<div class="meta">
							<span class="cmdline"><span class="prompt">$</span> cat post.md</span>
							<div class="date-tag">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="last-updated">
											(Updated: <FormattedDate date={updatedDate} />)
										</span>
									)
								}
							</div>
						</div>
						<h1 class="title">{title}</h1>
						{description && <p class="description">{description}</p>}
					</header>

					{heroImage && <div class="hero-image"><Image width={1020} height={510} src={heroImage} alt="" /></div>}

					<div class="markdown-body">
						<slot />
					</div>
				</div>
			</article>

			{showComments && <Comments />}
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-container {
		max-width: 860px;
		margin: 0 auto;
		padding: 2.5rem 1.25rem 0;
	}

	.article-body {
		padding: 2.2rem 2.4rem;
	}

	.article-header {
		margin-bottom: 2rem;
		border-bottom: 1px dashed var(--border-bright);
		padding-bottom: 1.5rem;
	}

	.meta {
		font-size: 0.82rem;
		margin-bottom: 1rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.cmdline {
		color: var(--text-dim);
	}

	.prompt {
		color: var(--green);
		font-weight: 700;
	}

	.date-tag {
		color: var(--amber);
	}

	.last-updated {
		color: var(--text-faint);
	}

	.title {
		font-size: clamp(1.6rem, 4vw, 2.1rem);
		margin: 0 0 0.8rem 0;
		line-height: 1.3;
	}

	.description {
		color: var(--text-dim);
		font-size: 0.95rem;
		margin: 0;
		line-height: 1.7;
	}

	.hero-image {
		margin-bottom: 2.2rem;
	}

	.hero-image img {
		width: 100%;
		border-radius: var(--radius);
		border: 1px solid var(--border);
	}

	/* ---------- Markdown 正文排版 ---------- */
	.markdown-body {
		color: var(--text);
		line-height: 1.85;
		font-size: 0.95rem;
	}

	.markdown-body :global(h1),
	.markdown-body :global(h2),
	.markdown-body :global(h3),
	.markdown-body :global(h4) {
		margin-top: 2.2rem;
		margin-bottom: 0.9rem;
	}

	.markdown-body :global(h2) {
		font-size: 1.45rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.45rem;
	}

	.markdown-body :global(h2)::before {
		content: "## ";
		color: var(--green-dim);
	}

	.markdown-body :global(h3) {
		font-size: 1.2rem;
	}

	.markdown-body :global(h3)::before {
		content: "### ";
		color: var(--green-dim);
	}

	.markdown-body :global(p) {
		margin: 1rem 0;
	}

	.markdown-body :global(ul),
	.markdown-body :global(ol) {
		padding-left: 1.5rem;
	}

	.markdown-body :global(li) {
		margin-bottom: 0.4rem;
	}

	.markdown-body :global(li::marker) {
		color: var(--green-dim);
	}

	.markdown-body :global(blockquote) {
		border-left: 3px solid var(--green-dim);
		background: rgba(63, 217, 127, 0.05);
		margin: 1.5rem 0;
		padding: 0.7rem 1.1rem;
		color: var(--text-dim);
		border-radius: 0 var(--radius) var(--radius) 0;
	}

	.markdown-body :global(blockquote p) {
		margin: 0.3rem 0;
	}

	.markdown-body :global(img) {
		border-radius: var(--radius);
		border: 1px solid var(--border);
	}

	.markdown-body :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
		font-size: 0.88rem;
	}

	.markdown-body :global(th),
	.markdown-body :global(td) {
		border: 1px solid var(--border);
		padding: 0.55rem 0.9rem;
		text-align: left;
	}

	.markdown-body :global(th) {
		background: var(--bg-elevated);
		color: var(--text-bright);
	}

	.markdown-body :global(tr:nth-child(even)) {
		background: var(--bg-inset);
	}

	.markdown-body :global(strong) {
		color: var(--text-bright);
	}

	@media (max-width: 720px) {
		.article-body {
			padding: 1.5rem 1.2rem;
		}
	}
</style>
